{
  "name": "logikos-dsp",
  "private": true,
  "version": "0.0.0",
  "description": "logikos-dsp: an open replacement for ManageEngine DataSecurity Plus (file audit/FIM, data risk assessment, ransomware/anomaly detection, storage analysis).",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev:backend": "pnpm --filter @logikos-dsp/backend dev",
    "dev:dashboard": "pnpm --filter @logikos-dsp/dashboard dev",
    "dev:agent": "pnpm --filter @logikos-dsp/agent dev",
    "dev:classification": "pnpm --filter @logikos-dsp/classification dev",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @logikos-dsp/backend prisma:migrate",
    "db:seed": "pnpm --filter @logikos-dsp/backend prisma:seed",
    "smb:up": "docker compose -f docker-compose.smb-test.yml up -d",
    "smb:down": "docker compose -f docker-compose.smb-test.yml down"
  }
}
