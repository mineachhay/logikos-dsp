DATABASE_URL="postgresql://logikos:logikos@localhost:5432/logikos_dsp"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
# Shared secret agents present to POST /agents/register (openssl rand -hex 32).
# Every agent needs the same value in its own AGENT_ENROLL_TOKEN.
AGENT_ENROLL_TOKEN="change-me-to-another-long-random-string"
# Encrypts file-server passwords at rest: 32 bytes (openssl rand -base64 32).
# Back it up separately from the database — restored credentials are unreadable without it.
SOURCE_CREDENTIALS_KEY="change-me"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Where an approved WEBHOOK_NOTIFICATION goes — set either or both.
# Telegram: token from @BotFather; chat id from getUpdates after messaging the bot (see README).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Generic JSON POST (Slack incoming webhook, n8n, the bundled webhook-logger, ...).
RESPONSE_WEBHOOK_URL="https://hooks.slack.com/services/..."
