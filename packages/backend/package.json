{
  "name": "@logikos-dsp/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "8.0.1",
    "@logikos-dsp/shared": "workspace:*",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "3.2.4"
  }
}
