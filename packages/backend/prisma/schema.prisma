generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FileEventType {
  CREATED
  MODIFIED
  DELETED
  RENAMED
  /// A copy: a new file matching one that's still there (previousPath names it).
  COPIED
  PERMISSION_CHANGED
}

enum ClassificationJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum SensitivePatternType {
  SSN
  CREDIT_CARD
  EMAIL
  PHONE
  PERSON
  ORGANIZATION
  LOCATION
}

enum AlertType {
  RANSOMWARE_RATE
  SENSITIVE_DATA_EXPOSED
  BACKUP_FAILED
  LOGIN_ATTACK
  BULK_FILE_READ
  COPY_TO_REMOVABLE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  role             Role      @default(VIEWER)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  lastLoginAt      DateTime?
  /// Consecutive failed logins; reset on success. Drives the lockout backoff
  /// in auth/loginThrottle.ts.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  approvedResponseActions ResponseAction[]
}

/// Login attempts, kept so a single IP can be throttled across accounts —
/// per-account lockout alone doesn't stop someone spraying one password over
/// many usernames. Pruned by the retention pass.
model LoginAttempt {
  id      String   @id @default(uuid())
  ip      String
  email   String
  success Boolean
  at      DateTime @default(now())

  @@index([ip, at])
  @@index([at])
}

model Agent {
  id           String    @id @default(uuid())
  key          String    @unique
  hostname     String
  watchedRoot  String
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// sha256 of the per-agent secret issued by POST /agents/register. Rotated
  /// on every registration; null for rows that predate agent auth (they must
  /// re-register) and for revoked agents.
  secretHash   String?
  /// Set by an ADMIN; a revoked agent can neither ingest nor re-register.
  revokedAt    DateTime?
  /// Reported at registration. "managed-sources" = it polls /agent-sync and
  /// can scan dashboard-configured shares; the Go agent doesn't send it.
  capabilities String[]  @default([])

  sources          Source[]
  connectionTests  ConnectionTest[]
  discoveryScans   DiscoveryScan[]
  fileEvents       FileEvent[]
  storageSnapshots StorageSnapshot[]
  alerts           Alert[]
}

enum SourceKind {
  LOCAL
  SMB
  M365
  GDRIVE
}

/// An SMB server configured from the dashboard. Its shares are Source rows.
model FileServer {
  id                String    @id @default(uuid())
  name              String    @unique
  host              String
  port              Int?
  domain            String?
  username          String
  /// AES-256-GCM, see src/crypto/credentials.ts. Never selected into a
  /// dashboard response; decrypted only for the agent a share is assigned to.
  passwordEnc       String
  enabled           Boolean   @default(true)
  /// Collect *who* changed files by reading the server's Security log over
  /// WinRM (Windows only) — see ARCHITECTURE.md "Who changed a file".
  activityEnabled   Boolean   @default(false)
  winrmPort         Int?
  /// Null = reuse the share account above. A separate account can be
  /// read-only on the share but a member of Event Log Readers.
  winrmUsername     String?
  winrmPasswordEnc  String?
  /// Also record file *reads* — the only trace a copy off the share leaves.
  /// Off by default: on a busy share reads are most of the audit volume.
  recordReads       Boolean   @default(false)
  /// How many distinct files one account may read in five minutes before it
  /// looks like copying a folder away. Null = the default (50).
  bulkReadThreshold Int?
  /// EventRecordID of the last Security event read, so each poll asks only for newer ones.
  activityBookmark  BigInt?
  lastActivityAt    DateTime?
  lastActivityError String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shares          Source[]
  connectionTests ConnectionTest[]
  activity        FileActivity[]
}

/// One watched root. Either an agent's own env-configured root (fileServerId
/// null, created at registration) or a dashboard-managed SMB share.
/// FileEvent/StorageSnapshot/Alert hang off this rather than off Agent, so one
/// agent can watch many shares without their events or rules mixing.
model Source {
  id              String      @id @default(uuid())
  kind            SourceKind
  /// Display root: "/data", "smb://host/share/sub", "m365://..." — what
  /// Agent.watchedRoot is for an agent's own source.
  rootLabel       String
  agentId         String?
  agent           Agent?      @relation(fields: [agentId], references: [id])
  fileServerId    String?
  /// Restrict: deleting a server is an explicit, audited, history-removing
  /// operation in routes/fileServers.ts. SetNull would silently turn its
  /// shares into rows that look like an agent's own source.
  fileServer      FileServer? @relation(fields: [fileServerId], references: [id], onDelete: Restrict)
  shareName       String?
  /// Normalized: no leading/trailing slashes, "/" separators, "" for the share root.
  subPath         String      @default("")
  scanIntervalSec Int         @default(300)
  enabled         Boolean     @default(true)
  lastScanAt      DateTime?
  lastScanError   String?
  lastFileCount   Int?
  lastTotalBytes  BigInt?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fileEvents       FileEvent[]
  copiedFromHere   FileEvent[]       @relation("CopiedFrom")
  storageSnapshots StorageSnapshot[]
  alerts           Alert[]
  activity         FileActivity[]

  @@unique([fileServerId, shareName, subPath])
  @@index([agentId])
}

enum DiscoveryScanStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// "Which machines are there, and which of them have no agent?" — the question
/// a coverage report answers. The backend can't scan a network any more than
/// it can talk SMB, so a scan is queued here and the assigned agent picks it
/// up on its next sync, exactly like a connection test.
model DiscoveryScan {
  id          String              @id @default(uuid())
  /// CIDR to sweep, e.g. "20.20.0.0/24". Validated before it is stored.
  cidr        String
  agentId     String
  agent       Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status      DiscoveryScanStatus @default(PENDING)
  message     String?
  /// Copied, so the record survives the user being deleted — same reasoning as AuditLog.
  requestedBy String
  createdAt   DateTime            @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  hosts DiscoveredHost[]

  @@index([agentId, status])
}

/// One machine a scan found. Kept per scan rather than merged into a single
/// live list: "what did we see, and when" is the honest shape, and a machine
/// that stopped answering should disappear from the next scan rather than
/// linger as a stale row nobody trusts.
model DiscoveredHost {
  id        String        @id @default(uuid())
  scanId    String
  scan      DiscoveryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  address   String
  /// Reverse DNS or NetBIOS, when it answered. Null is common and not an error.
  hostname  String?
  /// TCP ports that answered, e.g. [445, 3389]. What makes a host look like Windows.
  openPorts Int[]         @default([])
  createdAt DateTime      @default(now())

  @@unique([scanId, address])
  @@index([scanId])
}

enum ConnectionTestStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// "Test connection" from the dashboard. The backend can't reach file
/// servers, so the assigned agent picks this up on its next sync and reports.
model ConnectionTest {
  id           String               @id @default(uuid())
  fileServerId String
  fileServer   FileServer           @relation(fields: [fileServerId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  shareName    String
  subPath      String               @default("")
  status       ConnectionTestStatus @default(PENDING)
  message      String?
  createdAt    DateTime             @default(now())
  completedAt  DateTime?

  @@index([agentId, status])
}

/// Who changed monitoring configuration. Written by dashboard routes; the
/// email is copied so the entry survives the user being deleted.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum FileActivityAction {
  CREATE
  WRITE
  DELETE
  RENAME
  READ
  OTHER
}

/// One Windows audit record (Security event 5145): who touched what, from
/// where. Kept separately from FileEvent because the two come from different
/// places — SMB scans see *what* changed, the event log sees *who* — and are
/// matched by path and time (see matchActivity in packages/shared).
model FileActivity {
  id           String             @id @default(uuid())
  fileServerId String
  fileServer   FileServer         @relation(fields: [fileServerId], references: [id], onDelete: Cascade)
  sourceId     String?
  source       Source?            @relation(fields: [sourceId], references: [id])
  path         String
  action       FileActivityAction
  userName     String
  userDomain   String?
  clientIp     String?
  occurredAt   DateTime
  /// Windows EventRecordID — unique per server, so a re-poll can't duplicate rows.
  recordId     BigInt
  createdAt    DateTime           @default(now())

  @@unique([fileServerId, recordId])
  @@index([sourceId, path, occurredAt])
}

model FileEvent {
  id               String        @id @default(uuid())
  agentId          String
  agent            Agent         @relation(fields: [agentId], references: [id])
  sourceId         String
  source           Source        @relation(fields: [sourceId], references: [id])
  eventType        FileEventType
  path             String
  previousPath     String?
  sizeBytes        Int?
  contentSample    String?
  /// Where a copy came from, when it came from a *different* watched place —
  /// another share, or a laptop running an agent. previousPath alone is enough
  /// within one source.
  previousSourceId String?
  previousSource   Source?       @relation("CopiedFrom", fields: [previousSourceId], references: [id])
  /// Where the file landed, reported per watched root by the agent. A drive
  /// letter is reused by whatever is plugged in next, so the label and serial
  /// are what identify a particular USB stick after the fact.
  removable        Boolean       @default(false)
  volumeLabel      String?
  volumeSerial     String?
  /// Filled in from FileActivity when a Windows audit record matches this
  /// event's path and time; null when activity collection is off or nothing matched.
  actorUser        String?
  actorIp          String?
  occurredAt       DateTime
  receivedAt       DateTime      @default(now())

  classificationJob ClassificationJob?

  @@index([agentId, occurredAt])
  @@index([sourceId, occurredAt])
}

model StorageSnapshot {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id])
  rootPath   String
  totalBytes BigInt
  fileCount  Int
  takenAt    DateTime

  @@index([agentId, takenAt])
  @@index([sourceId, takenAt])
}

model ClassificationJob {
  id          String                  @id @default(uuid())
  fileEventId String                  @unique
  fileEvent   FileEvent               @relation(fields: [fileEventId], references: [id])
  status      ClassificationJobStatus @default(PENDING)
  createdAt   DateTime                @default(now())
  processedAt DateTime?

  matches ClassificationMatch[]

  @@index([status, createdAt])
}

model ClassificationMatch {
  id                  String               @id @default(uuid())
  classificationJobId String
  classificationJob   ClassificationJob    @relation(fields: [classificationJobId], references: [id])
  patternType         SensitivePatternType
  redactedSample      String
  path                String
  createdAt           DateTime             @default(now())
}

model Alert {
  id        String        @id @default(uuid())
  type      AlertType
  severity  AlertSeverity
  status    AlertStatus   @default(OPEN)
  agentId   String?
  agent     Agent?        @relation(fields: [agentId], references: [id])
  sourceId  String?
  source    Source?       @relation(fields: [sourceId], references: [id])
  message   String
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  responseActions ResponseAction[]

  @@index([status, createdAt])
}

enum ResponseActionType {
  WEBHOOK_NOTIFICATION
  FILE_QUARANTINE
}

enum ResponseActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model ResponseAction {
  id               String               @id @default(uuid())
  alertId          String
  alert            Alert                @relation(fields: [alertId], references: [id])
  type             ResponseActionType
  status           ResponseActionStatus @default(PENDING)
  approvedByUserId String?
  approvedByUser   User?                @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  executedAt       DateTime?
  resultMessage    String?
  createdAt        DateTime             @default(now())

  @@index([status, createdAt])
}

enum BackupDestinationType {
  S3
  SFTP
  GDRIVE
}

enum BackupRunKind {
  BACKUP
  VERIFY
  TEST_DESTINATION
}

enum BackupRunTrigger {
  SCHEDULE
  MANUAL
}

enum BackupRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Off-box backup configuration, edited under Administration -> Backups. A
/// single row (id "default"). Read by the backup worker (packages/backup),
/// which does the actual work; the backend never runs pg_dump or rclone.
model BackupSettings {
  id                  String                 @id @default("default")
  /// Scheduled backups on/off. Manual runs work either way once configured.
  enabled             Boolean                @default(false)
  /// "HH:MM", UTC.
  scheduleTimeUtc     String                 @default("03:15")
  /// Scheduled slots before this are ignored, so enabling at noon doesn't
  /// immediately run "this morning's" missed backup. Reset whenever the
  /// schedule is turned on or its time changes.
  scheduleActiveSince DateTime?
  /// 0 = Sunday .. 6 = Saturday, null = no scheduled restore check.
  verifyWeekday       Int?                   @default(0)
  localRetention      Int                    @default(14)
  remoteRetention     Int                    @default(30)
  destinationType     BackupDestinationType?
  /// Non-secret destination fields (bucket, host, folder id, ...).
  destinationConfig   Json?
  /// Secret destination fields as encrypted JSON (see shared/credentials.ts).
  /// Write-only through the API.
  credentialsEnc      String?
  /// Folder under the destination root that bundles go into.
  remotePath          String                 @default("logikos-dsp")
  /// age recipient ("age1..."). Bundles are encrypted to it before upload; the
  /// matching private key is never on this server.
  agePublicKey        String?
  workerHeartbeatAt   DateTime?
  updatedAt           DateTime               @updatedAt
}

/// Queue and history in one: the dashboard inserts PENDING manual runs, the
/// worker inserts scheduled ones, claims PENDING rows, and records outcomes.
model BackupRun {
  id               String           @id @default(uuid())
  kind             BackupRunKind
  trigger          BackupRunTrigger
  status           BackupRunStatus  @default(PENDING)
  requestedByEmail String?
  /// The schedule slot a SCHEDULE run belongs to; unique per kind so two
  /// workers (or a restart) can't both run the same slot.
  scheduledFor     DateTime?
  createdAt        DateTime         @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  /// Remote bundle name for BACKUP runs.
  fileName         String?
  sizeBytes        BigInt?
  sha256           String?
  uploaded         Boolean          @default(false)
  message          String?

  @@unique([kind, scheduledFor])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// How long collected data is kept, edited under Administration -> Retention.
/// A single row ("default"). Off by default: an install shouldn't start
/// deleting an audit trail because nobody looked at this page.
model RetentionSettings {
  id                  String    @id @default("default")
  enabled             Boolean   @default(false)
  fileEventDays       Int       @default(180)
  fileActivityDays    Int       @default(90)
  storageSnapshotDays Int       @default(365)
  /// Only alerts that have been resolved; open and acknowledged ones stay.
  resolvedAlertDays   Int       @default(365)
  loginAttemptDays    Int       @default(30)
  lastRunAt           DateTime?
  lastRunSummary      String?
  updatedAt           DateTime  @updatedAt
}
