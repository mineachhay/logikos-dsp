generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FileEventType {
  CREATED
  MODIFIED
  DELETED
  RENAMED
  PERMISSION_CHANGED
}

enum ClassificationJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum SensitivePatternType {
  SSN
  CREDIT_CARD
  EMAIL
  PHONE
  PERSON
  ORGANIZATION
  LOCATION
}

enum AlertType {
  RANSOMWARE_RATE
  SENSITIVE_DATA_EXPOSED
  BACKUP_FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  approvedResponseActions ResponseAction[]
}

model Agent {
  id           String   @id @default(uuid())
  key          String   @unique
  hostname     String
  watchedRoot  String
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  /// sha256 of the per-agent secret issued by POST /agents/register. Rotated
  /// on every registration; null for rows that predate agent auth (they must
  /// re-register) and for revoked agents.
  secretHash   String?
  /// Set by an ADMIN; a revoked agent can neither ingest nor re-register.
  revokedAt    DateTime?
  /// Reported at registration. "managed-sources" = it polls /agent-sync and
  /// can scan dashboard-configured shares; the Go agent doesn't send it.
  capabilities String[] @default([])

  sources          Source[]
  connectionTests  ConnectionTest[]
  fileEvents       FileEvent[]
  storageSnapshots StorageSnapshot[]
  alerts           Alert[]
}

enum SourceKind {
  LOCAL
  SMB
  M365
  GDRIVE
}

/// An SMB server configured from the dashboard. Its shares are Source rows.
model FileServer {
  id          String   @id @default(uuid())
  name        String   @unique
  host        String
  port        Int?
  domain      String?
  username    String
  /// AES-256-GCM, see src/crypto/credentials.ts. Never selected into a
  /// dashboard response; decrypted only for the agent a share is assigned to.
  passwordEnc String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shares          Source[]
  connectionTests ConnectionTest[]
}

/// One watched root. Either an agent's own env-configured root (fileServerId
/// null, created at registration) or a dashboard-managed SMB share.
/// FileEvent/StorageSnapshot/Alert hang off this rather than off Agent, so one
/// agent can watch many shares without their events or rules mixing.
model Source {
  id              String      @id @default(uuid())
  kind            SourceKind
  /// Display root: "/data", "smb://host/share/sub", "m365://..." — what
  /// Agent.watchedRoot is for an agent's own source.
  rootLabel       String
  agentId         String?
  agent           Agent?      @relation(fields: [agentId], references: [id])
  fileServerId    String?
  /// Restrict: deleting a server is an explicit, audited, history-removing
  /// operation in routes/fileServers.ts. SetNull would silently turn its
  /// shares into rows that look like an agent's own source.
  fileServer      FileServer? @relation(fields: [fileServerId], references: [id], onDelete: Restrict)
  shareName       String?
  /// Normalized: no leading/trailing slashes, "/" separators, "" for the share root.
  subPath         String      @default("")
  scanIntervalSec Int         @default(300)
  enabled         Boolean     @default(true)
  lastScanAt      DateTime?
  lastScanError   String?
  lastFileCount   Int?
  lastTotalBytes  BigInt?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fileEvents       FileEvent[]
  storageSnapshots StorageSnapshot[]
  alerts           Alert[]

  @@unique([fileServerId, shareName, subPath])
  @@index([agentId])
}

enum ConnectionTestStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// "Test connection" from the dashboard. The backend can't reach file
/// servers, so the assigned agent picks this up on its next sync and reports.
model ConnectionTest {
  id           String               @id @default(uuid())
  fileServerId String
  fileServer   FileServer           @relation(fields: [fileServerId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  shareName    String
  subPath      String               @default("")
  status       ConnectionTestStatus @default(PENDING)
  message      String?
  createdAt    DateTime             @default(now())
  completedAt  DateTime?

  @@index([agentId, status])
}

/// Who changed monitoring configuration. Written by dashboard routes; the
/// email is copied so the entry survives the user being deleted.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model FileEvent {
  id             String        @id @default(uuid())
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id])
  sourceId       String
  source         Source        @relation(fields: [sourceId], references: [id])
  eventType      FileEventType
  path           String
  previousPath   String?
  sizeBytes      Int?
  contentSample  String?
  occurredAt     DateTime
  receivedAt     DateTime      @default(now())

  classificationJob ClassificationJob?

  @@index([agentId, occurredAt])
  @@index([sourceId, occurredAt])
}

model StorageSnapshot {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id])
  rootPath   String
  totalBytes BigInt
  fileCount  Int
  takenAt    DateTime

  @@index([agentId, takenAt])
  @@index([sourceId, takenAt])
}

model ClassificationJob {
  id          String                   @id @default(uuid())
  fileEventId String                   @unique
  fileEvent   FileEvent                @relation(fields: [fileEventId], references: [id])
  status      ClassificationJobStatus  @default(PENDING)
  createdAt   DateTime                 @default(now())
  processedAt DateTime?

  matches ClassificationMatch[]

  @@index([status, createdAt])
}

model ClassificationMatch {
  id                  String               @id @default(uuid())
  classificationJobId String
  classificationJob   ClassificationJob    @relation(fields: [classificationJobId], references: [id])
  patternType         SensitivePatternType
  redactedSample      String
  path                String
  createdAt           DateTime             @default(now())
}

model Alert {
  id        String        @id @default(uuid())
  type      AlertType
  severity  AlertSeverity
  status    AlertStatus   @default(OPEN)
  agentId   String?
  agent     Agent?        @relation(fields: [agentId], references: [id])
  sourceId  String?
  source    Source?       @relation(fields: [sourceId], references: [id])
  message   String
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  responseActions ResponseAction[]

  @@index([status, createdAt])
}

enum ResponseActionType {
  WEBHOOK_NOTIFICATION
  FILE_QUARANTINE
}

enum ResponseActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model ResponseAction {
  id               String               @id @default(uuid())
  alertId          String
  alert            Alert                @relation(fields: [alertId], references: [id])
  type             ResponseActionType
  status           ResponseActionStatus @default(PENDING)
  approvedByUserId String?
  approvedByUser   User?                @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  executedAt       DateTime?
  resultMessage    String?
  createdAt        DateTime             @default(now())

  @@index([status, createdAt])
}

enum BackupDestinationType {
  S3
  SFTP
  GDRIVE
}

enum BackupRunKind {
  BACKUP
  VERIFY
  TEST_DESTINATION
}

enum BackupRunTrigger {
  SCHEDULE
  MANUAL
}

enum BackupRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Off-box backup configuration, edited under Administration -> Backups. A
/// single row (id "default"). Read by the backup worker (packages/backup),
/// which does the actual work; the backend never runs pg_dump or rclone.
model BackupSettings {
  id                  String                 @id @default("default")
  /// Scheduled backups on/off. Manual runs work either way once configured.
  enabled             Boolean                @default(false)
  /// "HH:MM", UTC.
  scheduleTimeUtc     String                 @default("03:15")
  /// Scheduled slots before this are ignored, so enabling at noon doesn't
  /// immediately run "this morning's" missed backup. Reset whenever the
  /// schedule is turned on or its time changes.
  scheduleActiveSince DateTime?
  /// 0 = Sunday .. 6 = Saturday, null = no scheduled restore check.
  verifyWeekday       Int?                   @default(0)
  localRetention      Int                    @default(14)
  remoteRetention     Int                    @default(30)
  destinationType     BackupDestinationType?
  /// Non-secret destination fields (bucket, host, folder id, ...).
  destinationConfig   Json?
  /// Secret destination fields as encrypted JSON (see shared/credentials.ts).
  /// Write-only through the API.
  credentialsEnc      String?
  /// Folder under the destination root that bundles go into.
  remotePath          String                 @default("logikos-dsp")
  /// age recipient ("age1..."). Bundles are encrypted to it before upload; the
  /// matching private key is never on this server.
  agePublicKey        String?
  workerHeartbeatAt   DateTime?
  updatedAt           DateTime               @updatedAt
}

/// Queue and history in one: the dashboard inserts PENDING manual runs, the
/// worker inserts scheduled ones, claims PENDING rows, and records outcomes.
model BackupRun {
  id               String           @id @default(uuid())
  kind             BackupRunKind
  trigger          BackupRunTrigger
  status           BackupRunStatus  @default(PENDING)
  requestedByEmail String?
  /// The schedule slot a SCHEDULE run belongs to; unique per kind so two
  /// workers (or a restart) can't both run the same slot.
  scheduledFor     DateTime?
  createdAt        DateTime         @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  /// Remote bundle name for BACKUP runs.
  fileName         String?
  sizeBytes        BigInt?
  sha256           String?
  uploaded         Boolean          @default(false)
  message          String?

  @@unique([kind, scheduledFor])
  @@index([status, createdAt])
  @@index([createdAt])
}
